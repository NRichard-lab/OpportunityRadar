.git
.gitignore

# Environment and credentials
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
**/.email_secret.key
secrets/
secrets.local.*
*.secret
*.secrets
*.key
*.pem
app-client-secret*
app-client-secrets*
smtp-secret*
smtp-credentials*
credentials.local.*

# Private/runtime data
data/
Input/
imports/
backups/
exports/
resumes/
logs/
output/
tmp/
frontend/public/data/
companies.json
jobs.json
applications.json
*.db
*.sqlite
*.sqlite3
*-wal
*-shm
*.db-journal
*.xls
*.xlsx
*.csv
*.tsv
*.pdf
*.doc
*.docx

# Local runtimes and browser state
.venv/
.codex-venv/
venv/
env/
.playwright-browsers/
.browser-profile/
browser-profiles/
frontend/node_modules/
frontend/dist/

# Tests, caches, and developer-only artifacts
tests/
docs/
CODE_REVIEW.md
__pycache__/
*.py[cod]
**/__pycache__/
**/*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pip-cache/
frontend/.npm-cache/
frontend/*.log
frontend/*.tsbuildinfo
playwright-report/
test-results/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Editor and operating-system files
.DS_Store
Thumbs.db
*.swp
*.swo
