# This file is a template. The application does not load .env automatically.
# Local authentication is accepted only with this explicit development/loopback setup.
APP_ENV=development
AUTH_MODE=local
APP_BASE_PATH=
APP_PUBLIC_URL=http://127.0.0.1:5173

# Phase 1A safety defaults. Opt in deliberately for local development only.
APP_ENABLE_BROWSER_JOBS=false
APP_ENABLE_COMPANY_REFRESH=false
APP_ENABLE_UTILITIES=false
APP_ENABLE_SCHEDULES=false
APP_ENABLE_DISCOVERY=false
APP_WRITE_FRONTEND_MIRRORS=false

# Production values (set in the process environment; do not commit real IDs or secrets):
# APP_ENV=production
# AUTH_MODE=blueash
# APP_BASE_PATH=/OpportunityRadar
# APP_PUBLIC_URL=https://blueashdigital.tech/OpportunityRadar
# BLUEASH_API_URL=https://api.blueashdigital.tech
# BLUEASH_LOGIN_URL=https://blueashdigital.tech/
# BLUEASH_SESSION_COOKIE=blueash_session
# BLUEASH_COOKIE_DOMAIN=.blueashdigital.tech
# BLUEASH_APP_SLUG=opportunity-radar
# APP_TRUSTED_ADMIN_USER_ID=<portal-user-uuid>
# APP_ENABLE_BROWSER_JOBS=false
# APP_ENABLE_COMPANY_REFRESH=false
# APP_ENABLE_UTILITIES=false
# APP_ENABLE_SCHEDULES=false
# APP_ENABLE_DISCOVERY=false
# APP_WRITE_FRONTEND_MIRRORS=false

# Runtime storage. Keep all writable/private paths outside the application image in production.
# APP_DATA_DIR=/var/lib/opportunity-radar
# DATABASE_URL=sqlite:////var/lib/opportunity-radar/opportunity_radar.db
# APP_IMPORT_DIR=/var/lib/opportunity-radar/imports
# APP_EXPORT_DIR=/var/lib/opportunity-radar/exports
# APP_BACKUP_DIR=/var/lib/opportunity-radar/backups
# APP_LOG_DIR=/var/log/opportunity-radar

# Optional Opportunity Radar digest email delivery. These are not authentication settings.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl_tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Opportunity Radar
SMTP_REPLY_TO=
