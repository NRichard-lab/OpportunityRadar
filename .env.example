# This file is a template. The application does not load .env automatically.
# Local authentication is accepted only with this explicit development/loopback setup.
APP_ENV=development
AUTH_MODE=local
APP_BASE_PATH=
APP_PUBLIC_URL=http://127.0.0.1:5173
# Build-time frontend base path. Export this before running npm build; Vite does not read this root template automatically.
VITE_BASE_PATH=/

# Phase 1A safety defaults. Opt in deliberately for local development only.
APP_ENABLE_BROWSER_JOBS=false
APP_ENABLE_COMPANY_REFRESH=false
APP_ENABLE_UTILITIES=false
APP_ENABLE_SCHEDULES=false
APP_ENABLE_DISCOVERY=false
APP_WRITE_FRONTEND_MIRRORS=false

# Hard upper bounds used by API, scheduled, and CLI execution.
APP_MAX_HTTP_WORKERS=4
APP_MAX_BROWSER_WORKERS=1
APP_MAX_ACTIVE_MAINTENANCE=1
DEPLOYMENT_VERSION=development
REQUIRE_EXISTING_DATABASE=false

# Phase 2 production uses deploy/opportunity-radar.env.example as its complete template.
# Portal handoff remains a Phase 3 placeholder and is not implemented in this phase:
# APP_ENV=production
# AUTH_MODE=portal_handoff
# APP_BASE_PATH=
# APP_PUBLIC_URL=https://radar.blueashdigital.tech
# VITE_BASE_PATH=/
# APP_ENABLE_BROWSER_JOBS=false
# APP_ENABLE_COMPANY_REFRESH=false
# APP_ENABLE_UTILITIES=false
# APP_ENABLE_SCHEDULES=false
# APP_ENABLE_DISCOVERY=false
# APP_WRITE_FRONTEND_MIRRORS=false
# APP_MAX_HTTP_WORKERS=4
# APP_MAX_BROWSER_WORKERS=1
# APP_MAX_ACTIVE_MAINTENANCE=1
# REQUIRE_EXISTING_DATABASE=true
# DEPLOYMENT_VERSION=<full-commit-sha>
# OPPORTUNITY_RADAR_SECRET_KEY=<set-securely-outside-git>

# Runtime storage. Keep all writable/private paths outside the application image in production.
# APP_DATA_DIR=/var/lib/opportunity-radar/data
# DATABASE_URL=sqlite:////var/lib/opportunity-radar/database/opportunity_radar.db
# APP_IMPORT_DIR=/var/lib/opportunity-radar/data/imports
# APP_OUTPUT_DIR=/var/lib/opportunity-radar/exports
# APP_EXPORT_DIR=/var/lib/opportunity-radar/exports
# APP_BACKUP_DIR=/var/lib/opportunity-radar/backups
# APP_LOG_DIR=/var/log/opportunity-radar

# Optional Opportunity Radar digest email delivery. These are not authentication settings.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl_tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Opportunity Radar
SMTP_REPLY_TO=
